DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cricket_connect
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted; LLM_API_KEY remains a legacy fallback.
# Keep only one key variable set.
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=20
CHAT_INDEX_DIR=data/chat_index
